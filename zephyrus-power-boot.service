[Unit]
Description=Zephyrus G16 Power Management on Boot
After=graphical.target cardwired.service
Wants=graphical.target
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'sleep 5 && /usr/local/bin/zephyrus-power-event $(cat /sys/class/power_supply/ACAD/online)'
RemainAfterExit=yes
[Install]
WantedBy=graphical.target
